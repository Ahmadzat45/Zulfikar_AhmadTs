<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zulfikar Ahmad Tsalats</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- AOS Library CSS (Animasi Scroll) -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <!-- GLightbox CSS (Pop-up Foto) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            html {
                scroll-behavior: smooth;
            }

            /* Mengunci offset scroll agar pas persis di bawah header */
            section[id], footer[id] {
                scroll-margin-top: 75px;
            }

            /* Nav Link Default */
            .navbar-nav .nav-link {
                color: #4a5568 !important;
                font-weight: 600 !important;
                padding-bottom: 4px !important;
                border-bottom: 2px solid transparent !important;
                transition: color 0.2s ease, border-bottom-color 0.2s ease;
            }

                .navbar-nav .nav-link:hover {
                    color: #0d6efd !important;
                }

                /* State Active */
                .navbar-nav .nav-link.active {
                    color: #0d6efd !important;
                    border-bottom-color: #0d6efd !important;
                }
    </style>
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm fixed-top">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">Zulfikar Ahmad Tsalats</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center" id="mainNav">
                        <li class="nav-item">
                            <a class="nav-link" href="#about">About Me</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#education">Education</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#experience">Experience</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#skills">Skills</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#projects">Project</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#certifications">Certifications</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#awards">Awards</a>
                        </li>

                        <!-- Tombol Contact Me -->
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <a class="btn btn-primary rounded-pill px-4" href="#contact">Contact Me</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer id="contact" class="bg-dark text-white py-4 mt-5">
        <div class="container text-center">
            <h4 class="fw-bold mb-3">LET'S WORK TOGETHER</h4>

            <div class="d-flex justify-content-center gap-4 mb-3">
                <a href="mailto:ahmadzat45@gmail.com" class="social-icon" title="Email Saya">
                    <img src="~/images/gmail_logo.png" alt="Email" style="width: 40px; height: 40px; object-fit: contain; border-radius: 8px;">
                </a>
                <a href="https://www.linkedin.com/in/zulfikar-ahmad-tsalats-b1671316b/" target="_blank" class="social-icon" title="LinkedIn Saya">
                    <img src="~/images/linkedin_logo.png" alt="LinkedIn" style="width: 40px; height: 40px; object-fit: contain; border-radius: 8px;">
                </a>
                <a href="https://www.instagram.com/zulfikar.ahmadts" target="_blank" class="social-icon" title="Instagram Saya">
                    <img src="~/images/instagram_logo.png" alt="Instagram" style="width: 40px; height: 40px; object-fit: contain; border-radius: 8px;">
                </a>
                <a href="https://github.com/Ahmadzat45" target="_blank" class="social-icon" title="GitHub Saya">
                    <img src="~/images/github_logo.png" alt="GitHub" style="width: 40px; height: 40px; object-fit: contain; border-radius: 50%; background-color: white;">
                </a>
            </div>

            <p class="text-white-50 small mb-0">
                &copy; <a href="/" style="color: #00e5ff; font-weight: bold; text-decoration: none;">Zulfikar Ahmad Tsalats</a>. All Rights Reserved.
            </p>
        </div>
    </footer>

    <!-- JS Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                // === PENGATURAN HEADER NAVIGASI ===
                const navLinks = document.querySelectorAll('#mainNav .nav-link');
                const navbar = document.querySelector('.navbar');
                let isClickScrolling = false;
                let scrollTimeout = null;

                function getHeaderOffset() {
                    return navbar ? navbar.offsetHeight : 75;
                }

                function setActive(targetLink) {
                    navLinks.forEach(link => link.classList.remove('active'));
                    if (targetLink) targetLink.classList.add('active');
                }

                document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                    anchor.addEventListener('click', function (e) {
                        const targetId = this.getAttribute('href');
                        if (!targetId || targetId === '#') return;

                        const targetEl = document.querySelector(targetId);
                        if (targetEl) {
                            e.preventDefault();

                            isClickScrolling = true;
                            clearTimeout(scrollTimeout);

                            const matchingLink = Array.from(navLinks).find(l => l.getAttribute('href') === targetId);
                            if (matchingLink) setActive(matchingLink);

                            const targetPos = targetEl.getBoundingClientRect().top + window.pageYOffset - getHeaderOffset();
                            window.scrollTo({
                                top: targetPos,
                                behavior: 'smooth'
                            });

                            const navbarCollapse = document.getElementById('navbarNav');
                            if (navbarCollapse && navbarCollapse.classList.contains('show')) {
                                const bsCollapse = bootstrap.Collapse.getInstance(navbarCollapse);
                                if (bsCollapse) bsCollapse.hide();
                            }

                            scrollTimeout = setTimeout(() => {
                                isClickScrolling = false;
                            }, 900);
                        }
                    });
                });

                const sections = Array.from(navLinks).map(link => {
                    const id = link.getAttribute('href');
                    return id && id.startsWith('#') ? document.querySelector(id) : null;
                }).filter(Boolean);

                function onScroll() {
                    if (isClickScrolling) return;

                    const scrollPos = window.scrollY + getHeaderOffset() + 20;
                    const bodyHeight = document.body.offsetHeight;

                    if (window.innerHeight + window.scrollY >= bodyHeight - 10) {
                        setActive(navLinks[navLinks.length - 1]);
                        return;
                    }

                    for (let i = sections.length - 1; i >= 0; i--) {
                        const sec = sections[i];
                        if (scrollPos >= sec.offsetTop) {
                            const matchingLink = Array.from(navLinks).find(l => l.getAttribute('href') === '#' + sec.id);
                            if (matchingLink) setActive(matchingLink);
                            break;
                        }
                    }
                }

                window.addEventListener('scroll', onScroll, { passive: true });
                onScroll();

                // === INISIALISASI GLIGHTBOX POP-UP ===
                if (typeof GLightbox !== 'undefined') {
                    GLightbox({
                        selector: '.glightbox',
                        touchNavigation: true,
                        loop: true,
                        zoomable: true,
                        openEffect: 'zoom',
                        closeEffect: 'zoom'
                    });
                }

                // === INISIALISASI AOS ANIMASI SCROLL ===
                if (typeof AOS !== 'undefined') {
                    AOS.init({
                        duration: 800,
                        easing: 'ease-in-out',
                        once: false,
                        offset: 100,
                        delay: 0,
                        mirror: true
                    });
                }
            });

            window.addEventListener('load', function () {
                if (typeof AOS !== 'undefined') {
                    AOS.refreshHard();
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>